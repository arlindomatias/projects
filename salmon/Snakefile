# RNA-seq GSE295281: .sra (NCBI/AWS) -> fastq -> FastQC -> Salmon -> count table por gene (tximport).
# Uso (env genomic-variants, Snakemake 9):
#   snakemake -n --use-conda
#   snakemake --use-conda --cores 8 --resources download=3 scratch_dump=1

import csv
import os

configfile: "config.yaml"

if "DATA" not in os.environ:
    raise ValueError("Variável de ambiente DATA não definida (arquivos grandes ficam em $DATA).")
D = os.path.join(os.environ["DATA"], config["data_subdir"])
# FASTQ temporários no SSD local (ver config.yaml).
S = os.path.expanduser(config["fastq_scratch"])

with open(config["samples"]) as f:
    SAMPLES = {row["run"]: row for row in csv.DictReader(f, delimiter="\t")}
RUNS = sorted(SAMPLES)

REL = config["gencode_release"]
TRANSCRIPTOME = f"{D}/ref/gencode.v{REL}.transcripts.fa.gz"
INDEX = f"{D}/ref/salmon_index_gencode_v{REL}"
SALMON_THREADS = config["threads"]["salmon"]

wildcard_constraints:
    run="|".join(RUNS),
    read="[12]",


rule all:
    input:
        "results/counts_gene.tsv",
        "results/counts_gene_lengthScaledTPM.tsv",
        "results/tpm_gene.tsv",
        "results/qc_summary.tsv",
        "results/multiqc_report.html",


# ---------------------------------------------------------------- download

rule download_sra:
    # Espelho público da NCBI no AWS S3 (o ENA está lento demais daqui: ~KB/s).
    output:
        f"{D}/sra/{{run}}.sra",
    params:
        url=lambda w: f"https://sra-pub-run-odp.s3.amazonaws.com/sra/{w.run}/{w.run}",
    resources:
        download=1,
    conda:
        "envs/sratools.yaml"
    log:
        "logs/download_sra/{run}.log",
    shell:
        """
        curl -fsSL --retry 10 --retry-all-errors --retry-delay 30 -C - \\
            -o {output}.part {params.url} 2> {log}
        vdb-validate {output}.part >> {log} 2>&1
        mv {output}.part {output}
        """


rule fasterq_dump:
    # FASTQ descompactado é temporário, no SSD: apagado depois do FastQC e do Salmon. O .sra (HD) é a cópia bruta.
    # resources scratch_dump=1 (via --resources): um fasterq-dump por vez, para limitar o uso do SSD.
    input:
        f"{D}/sra/{{run}}.sra",
    output:
        r1=temp(f"{S}/fastq/{{run}}_1.fastq"),
        r2=temp(f"{S}/fastq/{{run}}_2.fastq"),
    threads: config["threads"]["fasterq_dump"]
    resources:
        scratch_dump=1,
    conda:
        "envs/sratools.yaml"
    log:
        "logs/fasterq_dump/{run}.log",
    shell:
        """
        fasterq-dump {input} --split-files --threads {threads} \\
            --outdir {S}/fastq --temp {S}/tmp &> {log}
        """


rule download_transcriptome:
    output:
        TRANSCRIPTOME,
    params:
        url=config["transcriptome_url"],
    resources:
        download=1,
    log:
        "logs/download_transcriptome/download.log",
    shell:
        """
        curl -fsSL --retry 5 --retry-delay 30 -o {output}.part {params.url} 2> {log}
        gzip -t {output}.part
        mv {output}.part {output}
        """


# ---------------------------------------------------------------- QC

rule fastqc:
    input:
        f"{S}/fastq/{{run}}_{{read}}.fastq",
    output:
        html=f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.html",
        zip=f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.zip",
    threads: config["threads"]["fastqc"]
    priority: 5
    conda:
        "envs/qc.yaml"
    log:
        "logs/fastqc/{run}_{read}.log",
    shell:
        "fastqc --threads {threads} --outdir {D}/qc/fastqc {input} &> {log}"


rule multiqc:
    input:
        expand(f"{D}/qc/fastqc/{{run}}_{{read}}_fastqc.zip", run=RUNS, read=[1, 2]),
        expand(f"{D}/salmon/{{run}}/quant.sf", run=RUNS),
    output:
        "results/multiqc_report.html",
    conda:
        "envs/qc.yaml"
    log:
        "logs/multiqc/multiqc.log",
    shell:
        """
        multiqc --force --no-data-dir --filename multiqc_report.html --outdir results \
            {D}/qc/fastqc {D}/salmon &> {log}
        """


# ---------------------------------------------------------------- Salmon

rule salmon_index:
    input:
        TRANSCRIPTOME,
    output:
        directory(INDEX),
    threads: SALMON_THREADS
    conda:
        "envs/salmon.yaml"
    log:
        "logs/salmon_index/index.log",
    shell:
        "salmon index -t {input} -i {output} -k 31 --gencode -p {threads} &> {log}"


rule salmon_quant:
    input:
        r1=f"{S}/fastq/{{run}}_1.fastq",
        r2=f"{S}/fastq/{{run}}_2.fastq",
        index=INDEX,
    output:
        quant=f"{D}/salmon/{{run}}/quant.sf",
        meta=f"{D}/salmon/{{run}}/aux_info/meta_info.json",
        libfmt=f"{D}/salmon/{{run}}/lib_format_counts.json",
    params:
        outdir=f"{D}/salmon/{{run}}",
    threads: SALMON_THREADS
    # Prioridade alta: consumir os FASTQ temporários antes de gerar novos (senão eles se acumulam no HD).
    priority: 10
    conda:
        "envs/salmon.yaml"
    log:
        "logs/salmon_quant/{run}.log",
    shell:
        """
        salmon quant -i {input.index} -l A \
            -1 {input.r1} -2 {input.r2} \
            -p {threads} --gcBias --seqBias \
            -o {params.outdir} &> {log}
        """


rule check_mapping_rate:
    input:
        f"{D}/salmon/{{run}}/aux_info/meta_info.json",
    output:
        f"{D}/salmon/{{run}}/mapping_ok.txt",
    params:
        min_rate=config["min_mapping_rate"],
    log:
        "logs/check_mapping_rate/{run}.log",
    run:
        import json

        rate = json.load(open(input[0]))["percent_mapped"]
        msg = f"{wildcards.run}: mapping rate = {rate:.2f}% (mínimo {params.min_rate}%)"
        with open(log[0], "w") as f:
            f.write(msg + "\n")
        if rate < params.min_rate:
            raise ValueError("Mapping rate muito baixo -- " + msg)
        with open(output[0], "w") as f:
            f.write(msg + "\n")


# ---------------------------------------------------------------- count table

rule tx2gene:
    input:
        TRANSCRIPTOME,
    output:
        "results/tx2gene.tsv",
    log:
        "logs/tx2gene/tx2gene.log",
    shell:
        "python3 scripts/tx2gene.py {input} {output} &> {log}"


rule qc_summary:
    input:
        samples=config["samples"],
        meta=expand(f"{D}/salmon/{{run}}/aux_info/meta_info.json", run=RUNS),
        libfmt=expand(f"{D}/salmon/{{run}}/lib_format_counts.json", run=RUNS),
    output:
        "results/qc_summary.tsv",
    params:
        salmon_dir=f"{D}/salmon",
    log:
        "logs/qc_summary/qc_summary.log",
    shell:
        "python3 scripts/qc_summary.py {input.samples} {params.salmon_dir} {output} &> {log}"


rule tximport:
    input:
        samples=config["samples"],
        tx2gene="results/tx2gene.tsv",
        quant=expand(f"{D}/salmon/{{run}}/quant.sf", run=RUNS),
        ok=expand(f"{D}/salmon/{{run}}/mapping_ok.txt", run=RUNS),
    output:
        counts="results/counts_gene.tsv",
        scaled="results/counts_gene_lengthScaledTPM.tsv",
        tpm="results/tpm_gene.tsv",
        length="results/length_gene.tsv",
        rds="results/txi_gene.rds",
    params:
        salmon_dir=f"{D}/salmon",
    conda:
        "envs/tximport.yaml"
    log:
        "logs/tximport/tximport.log",
    shell:
        """
        Rscript scripts/tximport.R {input.samples} {params.salmon_dir} {input.tx2gene} \
            {output.counts} {output.scaled} {output.tpm} {output.length} {output.rds} &> {log}
        """
