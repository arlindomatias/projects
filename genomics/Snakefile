# Germline variant-calling pipeline: FASTQ -> filtered VCF -> benchmark vs GIAB truth set,
# plus SnpEff annotation and a DeepVariant comparison on the same BAM.
# Usage: snakemake --use-conda --cores 8

import os

configfile: "config.yaml"

# Expand environment variables (e.g. $DATA) in sample paths; fail early if unset.
if "DATA" not in os.environ:
    raise ValueError("Environment variable DATA is not set (raw reads are read from $DATA).")
SAMPLES = {
    s: {k: os.path.expandvars(v) for k, v in reads.items()}
    for s, reads in config["samples"].items()
}
REF = config["reference"]
REF_DICT = os.path.splitext(REF)[0] + ".dict"
REGION = config["region"]
SNPEFF_DB = config["snpeff_db"]
SNPEFF_DIR = os.path.abspath(os.path.expandvars(config["snpeff_data_dir"]))
WORKDIR = os.getcwd()


rule all:
    input:
        expand("results/qc/{sample}_fastp.html", sample=SAMPLES),
        expand("results/eval/{sample}", sample=SAMPLES),
        expand("results/annot/{sample}.snpeff.vcf.gz", sample=SAMPLES),
        expand("results/eval_deepvariant/{sample}", sample=SAMPLES),


# ---------------------------------------------------------------- QC and alignment

rule fastp:
    input:
        r1=lambda wc: SAMPLES[wc.sample]["r1"],
        r2=lambda wc: SAMPLES[wc.sample]["r2"],
    output:
        r1="results/trimmed/{sample}_R1.fastq.gz",
        r2="results/trimmed/{sample}_R2.fastq.gz",
        html="results/qc/{sample}_fastp.html",
        json="results/qc/{sample}_fastp.json",
    threads: 4
    conda: "envs/pipeline.yaml"
    log: "logs/fastp/{sample}.log"
    shell:
        "fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} "
        "-h {output.html} -j {output.json} -w {threads} 2> {log}"


rule bwa_index:
    input: REF
    output: multiext(REF, ".amb", ".ann", ".bwt", ".pac", ".sa")
    threads: 1
    conda: "envs/pipeline.yaml"
    log: "logs/bwa_index/reference.log"
    shell: "bwa index {input} > {log} 2>&1"


rule faidx:
    input: REF
    output: REF + ".fai"
    threads: 1
    conda: "envs/pipeline.yaml"
    log: "logs/faidx/reference.log"
    shell: "samtools faidx {input} > {log} 2>&1"


rule map_and_markdup:
    input:
        ref=REF,
        idx=multiext(REF, ".amb", ".ann", ".bwt", ".pac", ".sa"),
        r1="results/trimmed/{sample}_R1.fastq.gz",
        r2="results/trimmed/{sample}_R2.fastq.gz",
    output:
        bam="results/bam/{sample}.markdup.bam",
        bai="results/bam/{sample}.markdup.bam.bai",
    params:
        rg=lambda wc: f"@RG\\tID:{wc.sample}\\tSM:{wc.sample}\\tPL:ILLUMINA",
        sort_mem="512M",  # per sort thread; keeps peak RAM low next to bwa's ~5 GB index
        sort_tmp=lambda wc: f"results/bam/{wc.sample}.sort_tmp",
    threads: 8
    conda: "envs/pipeline.yaml"
    log: "logs/map_and_markdup/{sample}.log"
    shell:
        # bwa mem output is already name-grouped (mates adjacent), so fixmate can read it directly.
        "(bwa mem -t {threads} -R '{params.rg}' {input.ref} {input.r1} {input.r2} "
        "| samtools fixmate -m -u - - "
        "| samtools sort -u -@ 2 -m {params.sort_mem} -T {params.sort_tmp} - "
        "| samtools markdup -@ 2 - {output.bam} && "
        "samtools index {output.bam}) 2> {log}"


# ---------------------------------------------------------------- GATK calling and filtering

rule seq_dict:
    input: REF
    output: REF_DICT
    threads: 1
    conda: "envs/gatk.yaml"
    log: "logs/seq_dict/reference.log"
    shell: "gatk CreateSequenceDictionary -R {input} -O {output} > {log} 2>&1"


rule call_variants:
    input:
        ref=REF,
        fai=REF + ".fai",
        dict=REF_DICT,
        bam="results/bam/{sample}.markdup.bam",
        bai="results/bam/{sample}.markdup.bam.bai",
    output:
        vcf="results/vcf/{sample}.raw.vcf.gz",
        tbi="results/vcf/{sample}.raw.vcf.gz.tbi",
    params:
        region=REGION,
        java_mem="-Xmx4g",
    threads: 4
    conda: "envs/gatk.yaml"
    log: "logs/call_variants/{sample}.log"
    shell:
        # GATK HaplotypeCaller (single-sample, direct VCF); writes the .tbi index itself.
        "gatk --java-options '{params.java_mem}' HaplotypeCaller "
        "-R {input.ref} -I {input.bam} -L {params.region} -O {output.vcf} "
        "--native-pair-hmm-threads {threads} > {log} 2>&1"


rule filter_variants:
    input: "results/vcf/{sample}.raw.vcf.gz"
    output:
        vcf="results/vcf/{sample}.filtered.vcf.gz",
        tbi="results/vcf/{sample}.filtered.vcf.gz.tbi",
    params:
        expr=config["filter"],
    threads: 1
    conda: "envs/pipeline.yaml"
    log: "logs/filter_variants/{sample}.log"
    shell:
        "(bcftools filter -e '{params.expr}' -Oz -o {output.vcf} {input} && "
        "tabix -p vcf {output.vcf}) 2> {log}"


# ---------------------------------------------------------------- Benchmark (GIAB truth set)

rule rtg_sdf:
    input: REF
    output: directory("results/ref.sdf")
    threads: 1
    conda: "envs/pipeline.yaml"
    log: "logs/rtg_sdf/reference.log"
    shell: "rtg format -o {output} {input} > {log} 2>&1"


rule benchmark:
    input:
        query="results/vcf/{sample}.filtered.vcf.gz",
        sdf="results/ref.sdf",
        truth=config["truth_vcf"],
        bed=config["truth_bed"],
    output: directory("results/eval/{sample}")
    params:
        region=REGION,
    threads: 1
    conda: "envs/pipeline.yaml"
    log: "logs/benchmark/{sample}.log"
    shell:
        "rtg vcfeval -b {input.truth} -c {input.query} -t {input.sdf} "
        "-e {input.bed} --region {params.region} -o {output} > {log} 2>&1"


# ---------------------------------------------------------------- Annotation (SnpEff)

rule snpeff_db:
    output: directory(os.path.join(SNPEFF_DIR, SNPEFF_DB))
    params:
        db=SNPEFF_DB,
        data_dir=SNPEFF_DIR,
    threads: 1
    conda: "envs/annotation.yaml"
    log: "logs/snpeff_db/download.log"
    shell: "snpEff download -v -dataDir {params.data_dir} {params.db} > {log} 2>&1"


rule annotate:
    input:
        vcf="results/vcf/{sample}.filtered.vcf.gz",
        db=os.path.join(SNPEFF_DIR, SNPEFF_DB),
    output:
        vcf="results/annot/{sample}.snpeff.vcf.gz",
        tbi="results/annot/{sample}.snpeff.vcf.gz.tbi",
        html="results/annot/{sample}.snpeff.html",
    params:
        db=SNPEFF_DB,
        data_dir=SNPEFF_DIR,
        java_mem="-Xmx4g",
    threads: 1
    conda: "envs/annotation.yaml"
    log: "logs/annotate/{sample}.log"
    shell:
        # SnpEff matches "chr20" to the database's "20" contig automatically.
        "(snpEff {params.java_mem} ann -dataDir {params.data_dir} -stats {output.html} "
        "{params.db} {input.vcf} | bgzip -c > {output.vcf} && "
        "tabix -p vcf {output.vcf}) 2> {log}"


# ---------------------------------------------------------------- DeepVariant comparison

# DeepVariant ships as an official Docker image (no working conda package), so this rule
# runs it through `docker run` instead of a `conda:` env. The project dir is mounted at the
# same path, so all paths stay relative to the working directory.
rule deepvariant:
    input:
        ref=REF,
        fai=REF + ".fai",
        bam="results/bam/{sample}.markdup.bam",
        bai="results/bam/{sample}.markdup.bam.bai",
    output:
        vcf="results/vcf/{sample}.deepvariant.vcf.gz",
        tbi="results/vcf/{sample}.deepvariant.vcf.gz.tbi",
    params:
        image=config["deepvariant_image"],
        region=REGION,
        workdir=WORKDIR,
        tmp=lambda wc: f"results/deepvariant_tmp/{wc.sample}",
    threads: 8
    log: "logs/deepvariant/{sample}.log"
    shell:
        "docker run --rm -u $(id -u):$(id -g) -v {params.workdir}:{params.workdir} "
        "-w {params.workdir} {params.image} /opt/deepvariant/bin/run_deepvariant "
        "--model_type=WGS --ref={input.ref} --reads={input.bam} --regions={params.region} "
        "--output_vcf={output.vcf} --num_shards={threads} "
        "--intermediate_results_dir={params.tmp} > {log} 2>&1 && rm -rf {params.tmp}"


rule benchmark_deepvariant:
    input:
        # vcfeval only scores PASS records, so DeepVariant's RefCall/NoCall sites are ignored.
        query="results/vcf/{sample}.deepvariant.vcf.gz",
        sdf="results/ref.sdf",
        truth=config["truth_vcf"],
        bed=config["truth_bed"],
    output: directory("results/eval_deepvariant/{sample}")
    params:
        region=REGION,
    threads: 1
    conda: "envs/pipeline.yaml"
    log: "logs/benchmark_deepvariant/{sample}.log"
    shell:
        "rtg vcfeval -b {input.truth} -c {input.query} -t {input.sdf} "
        "-e {input.bed} --region {params.region} -o {output} > {log} 2>&1"
