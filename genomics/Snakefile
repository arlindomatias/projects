# Minimal germline variant-calling pipeline: FASTQ -> filtered VCF -> benchmark vs GIAB truth set.
# Usage: snakemake --use-conda --cores 8

import os

configfile: "config.yaml"

# Expand environment variables (e.g. $DATA) in sample paths; fail early if unset.
if "DATA" not in os.environ:
    raise ValueError("Environment variable DATA is not set (raw reads are read from $DATA).")
SAMPLES = {
    s: {k: os.path.expandvars(v) for k, v in reads.items()}
    for s, reads in config["samples"].items()
}
REF = config["reference"]
REGION = config["region"]


rule all:
    input:
        expand("results/eval/{sample}", sample=SAMPLES),
        expand("results/qc/{sample}_fastp.html", sample=SAMPLES),


rule fastp:
    input:
        r1=lambda wc: SAMPLES[wc.sample]["r1"],
        r2=lambda wc: SAMPLES[wc.sample]["r2"],
    output:
        r1="results/trimmed/{sample}_R1.fastq.gz",
        r2="results/trimmed/{sample}_R2.fastq.gz",
        html="results/qc/{sample}_fastp.html",
        json="results/qc/{sample}_fastp.json",
    threads: 4
    conda: "envs/pipeline.yaml"
    shell:
        "fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} "
        "-h {output.html} -j {output.json} -w {threads}"


rule bwa_index:
    input: REF
    output: multiext(REF, ".amb", ".ann", ".bwt", ".pac", ".sa")
    conda: "envs/pipeline.yaml"
    shell: "bwa index {input}"


rule faidx:
    input: REF
    output: REF + ".fai"
    conda: "envs/pipeline.yaml"
    shell: "samtools faidx {input}"


rule map_and_markdup:
    input:
        ref=REF,
        idx=multiext(REF, ".amb", ".ann", ".bwt", ".pac", ".sa"),
        r1="results/trimmed/{sample}_R1.fastq.gz",
        r2="results/trimmed/{sample}_R2.fastq.gz",
    output:
        bam="results/bam/{sample}.markdup.bam",
        bai="results/bam/{sample}.markdup.bam.bai",
    params:
        rg=lambda wc: f"@RG\\tID:{wc.sample}\\tSM:{wc.sample}\\tPL:ILLUMINA",
        sort_mem="512M",  # per sort thread; keeps peak RAM low next to bwa's ~5 GB index
        sort_tmp=lambda wc: f"results/bam/{wc.sample}.sort_tmp",
    threads: 8
    conda: "envs/pipeline.yaml"
    shell:
        # bwa mem output is already name-grouped (mates adjacent), so fixmate can read it directly.
        "bwa mem -t {threads} -R '{params.rg}' {input.ref} {input.r1} {input.r2} "
        "| samtools fixmate -m -u - - "
        "| samtools sort -u -@ 2 -m {params.sort_mem} -T {params.sort_tmp} - "
        "| samtools markdup -@ 2 - {output.bam} && "
        "samtools index {output.bam}"


rule seq_dict:
    input: REF
    output: os.path.splitext(REF)[0] + ".dict"
    threads: 1
    conda: "envs/gatk.yaml"
    log: "logs/seq_dict/reference.log"
    shell: "gatk CreateSequenceDictionary -R {input} -O {output} > {log} 2>&1"


rule call_variants:
    input:
        ref=REF,
        fai=REF + ".fai",
        dict=os.path.splitext(REF)[0] + ".dict",
        bam="results/bam/{sample}.markdup.bam",
        bai="results/bam/{sample}.markdup.bam.bai",
    output:
        vcf="results/vcf/{sample}.raw.vcf.gz",
        tbi="results/vcf/{sample}.raw.vcf.gz.tbi",
    params:
        region=REGION,
        java_mem="-Xmx4g",
    threads: 4
    conda: "envs/gatk.yaml"
    log: "logs/call_variants/{sample}.log"
    shell:
        # GATK HaplotypeCaller (single-sample, direct VCF); writes the .tbi index itself.
        "gatk --java-options '{params.java_mem}' HaplotypeCaller "
        "-R {input.ref} -I {input.bam} -L {params.region} -O {output.vcf} "
        "--native-pair-hmm-threads {threads} > {log} 2>&1"


rule filter_variants:
    input: "results/vcf/{sample}.raw.vcf.gz"
    output:
        vcf="results/vcf/{sample}.filtered.vcf.gz",
        tbi="results/vcf/{sample}.filtered.vcf.gz.tbi",
    params:
        expr=config["filter"],
    conda: "envs/pipeline.yaml"
    shell:
        "bcftools filter -e '{params.expr}' -Oz -o {output.vcf} {input} && "
        "tabix -p vcf {output.vcf}"


rule rtg_sdf:
    input: REF
    output: directory("results/ref.sdf")
    conda: "envs/pipeline.yaml"
    shell: "rtg format -o {output} {input}"


rule benchmark:
    input:
        query="results/vcf/{sample}.filtered.vcf.gz",
        sdf="results/ref.sdf",
        truth=config["truth_vcf"],
        bed=config["truth_bed"],
    output: directory("results/eval/{sample}")
    params:
        region=REGION,
    conda: "envs/pipeline.yaml"
    shell:
        "rtg vcfeval -b {input.truth} -c {input.query} -t {input.sdf} "
        "-e {input.bed} --region {params.region} -o {output}"
