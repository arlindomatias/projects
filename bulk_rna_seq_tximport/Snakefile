# ============================================================
# Bulk RNA-seq: expressão diferencial e enriquecimento a partir de tximport
# Generalização do pipeline bulk-rna-seq (GSE178812) para saídas do Salmon.
# ============================================================

configfile: "config.yaml"

ENV = "envs/deseq2.yaml"


rule all:
    input:
        "results/top_table.csv",
        "results/de_summary.tsv",
        "results/GSEA_GO_all_full.csv",
        "results/GSEA_KEGG_full.csv",
        "results/enrichment_STRING_full.csv",
        "results/sessionInfo.txt",


# ------------------------------------------------------------
# 01: tximport + samples.tsv -> objeto DESeq2 (ainda sem ajuste)
# ------------------------------------------------------------
rule prepare:
    input:
        txi=config["input"]["txi"],
        samples=config["input"]["samples"],
        tx2gene=config["input"]["tx2gene"],
    output:
        dds="results/dds_raw.rds",
        coldata="results/colData.csv",
    conda:
        ENV
    log:
        "logs/prepare.log",
    script:
        "scripts/01_prepare.R"


# ------------------------------------------------------------
# 02: QC e expressão diferencial
# ------------------------------------------------------------
rule differential:
    input:
        dds="results/dds_raw.rds",
    output:
        dds="results/dds.rds",
        top_table="results/top_table.csv",
        summary="results/de_summary.tsv",
        norm_counts="results/normalized_counts.csv",
        pca="plots/pca_vst.png",
        sample_dist="plots/sample_distances.png",
        markers="plots/marker_genes.png",
        volcano="plots/volcano.png",
        heatmap="plots/heatmap.png",
        fdr="plots/fdr_histogram.png",
        boxplot="plots/boxplot.png",
        qqplot="plots/QQPlot.png",
        ma="plots/MAplot.png",
        dispersion="plots/dispersion_plot.png",
        density="plots/density_counts.png",
        cooks="plots/cooks_distance.png",
    conda:
        ENV
    log:
        "logs/differential.log",
    script:
        "scripts/02_differential_expression_and_qc.R"


# ------------------------------------------------------------
# Anotação KEGG baixada uma vez (a API REST é lenta e às vezes trava; o gseKEGG
# baixava a cada execução). Apagar cache/kegg/ para atualizar.
# ------------------------------------------------------------
KEGG_ORG = config["enrichment"]["organism_kegg"]

rule kegg_annotation:
    output:
        link=f"cache/kegg/{KEGG_ORG}_link_pathway.tsv",
        names=f"cache/kegg/{KEGG_ORG}_list_pathway.tsv",
    params:
        url="https://rest.kegg.jp",
        org=KEGG_ORG,
    log:
        "logs/kegg_annotation.log",
    shell:
        """
        (date -Iseconds
         curl -fsS --retry 5 --retry-all-errors --retry-delay 30 -m 1800 \\
             -o {output.link}.part {params.url}/link/{params.org}/pathway
         curl -fsS --retry 5 --retry-all-errors --retry-delay 30 -m 600 \\
             -o {output.names}.part {params.url}/list/pathway/{params.org}
         test -s {output.link}.part && test -s {output.names}.part
         mv {output.link}.part {output.link}
         mv {output.names}.part {output.names}
         wc -l {output.link} {output.names}) > {log} 2>&1
        """


# ------------------------------------------------------------
# 03: GSEA (GO, KEGG), pathview e STRING. Precisa de internet (pathview, STRING).
# ------------------------------------------------------------
rule enrichment:
    input:
        top_table="results/top_table.csv",
        kegg_link=rules.kegg_annotation.output.link,
        kegg_names=rules.kegg_annotation.output.names,
    output:
        go="results/GSEA_GO_all_full.csv",
        kegg="results/GSEA_KEGG_full.csv",
        string="results/enrichment_STRING_full.csv",
        edges="results/edges_PPI.csv",
        nodes="results/nodes_PPI.csv",
        session="results/sessionInfo.txt",
    conda:
        ENV
    log:
        "logs/enrichment.log",
    script:
        "scripts/03_enrichment.R"
