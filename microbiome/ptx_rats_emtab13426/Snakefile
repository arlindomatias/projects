    input:
        rmd="report.Rmd",
        ps="results/phyloseq/ps.rds",
        track="results/dada2/read_tracking.tsv",
        quality="results/qc/quality_profiles.png",
        errors="results/qc/error_models.png",
        authors_genus=cfg_path("authors_genus_table"),
    output:
        html="results/report/report.html",
        tables=directory("results/report/tables"),
    params:
        seed=config["seed"],
    threads: 4
    conda: "envs/report.yaml"
    log: "logs/report/report.log"
    script: "scripts/render_report.R"
